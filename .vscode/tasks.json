{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Console (PowerShell)",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "powershell.exe"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run.ps1",
        "-BuildOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
