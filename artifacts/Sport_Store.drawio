<mxfile host="app.diagrams.net" pages="3">
  <diagram name="01 - Tổng quan (20 class)" id="AqDUw7xHZeKoWfD3By1L">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\n%% 1. SAN PHAM\nclass SanPham {\n  &lt;&lt;abstract&gt;&gt;\n  -String maSanPham\n  -String tenSanPham\n  -String thuongHieu\n  -BigDecimal giaBan\n  -int soLuongTon\n  -String mauSac\n  -String chatLieu\n  -DanhMuc danhMuc\n  +SanPham(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm)\n  +getMaSanPham() String\n  +getTenSanPham() String\n  +getGiaBan() BigDecimal\n  +getSoLuongTon() int\n  +getDanhMuc() DanhMuc\n  +capNhatThongTin(String ten, String hang, String mau, String chatLieu) void\n  +capNhatGiaBan(BigDecimal giaMoi) void\n  +conDuHang(int soLuong) boolean\n  +tangTon(int soLuong) void\n  +giamTon(int soLuong) void\n  +tinhGiaTriTonTheoGiaBan() BigDecimal\n  +layLoaiSanPham() String*\n  +hienThiThongTin() String*\n}\nclass GiayTheThao {\n  -String kichCoGiay\n  -String loaiDeGiay\n  +GiayTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, String kichCo, String loaiDe)\n  +getKichCoGiay() String\n  +getLoaiDeGiay() String\n  +capNhatKichCo(String kichCoMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\nclass QuanAoTheThao {\n  -String kichCoQuanAo\n  +QuanAoTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, String kichCo)\n  +getKichCoQuanAo() String\n  +capNhatKichCo(String kichCoMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\nclass DungCuTheThao {\n  -double khoiLuongKg\n  +DungCuTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, double khoiLuongKg)\n  +getKhoiLuongKg() double\n  +capNhatKhoiLuong(double khoiLuongMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\nclass DanhMuc {\n  -String maDanhMuc\n  -String tenDanhMuc\n  -String moTa\n  +DanhMuc(String ma, String ten, String moTa)\n  +getMaDanhMuc() String\n  +getTenDanhMuc() String\n  +capNhatThongTin(String ten, String moTa) void\n  +hienThiThongTin() String\n}\n\n%% 2. DOI TUONG GIAO DICH\nclass KhachHang {\n  -String maKhachHang\n  -String hoTen\n  -String soDienThoai\n  -String diaChi\n  +KhachHang(String ma, String ten, String sdt, String diaChi)\n  +getMaKhachHang() String\n  +getHoTen() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\nclass NhanVien {\n  -String maNhanVien\n  -String hoTen\n  -String soDienThoai\n  -String caLamViec\n  +NhanVien(String ma, String ten, String sdt, String ca)\n  +getMaNhanVien() String\n  +getHoTen() String\n  +capNhatLienHe(String soDienThoai) void\n  +doiCaLamViec(String caMoi) void\n  +hienThiThongTin() String\n}\nclass NhaCungCap {\n  -String maNhaCungCap\n  -String tenNhaCungCap\n  -String soDienThoai\n  -String diaChi\n  +NhaCungCap(String ma, String ten, String sdt, String diaChi)\n  +getMaNhaCungCap() String\n  +getTenNhaCungCap() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\n\n%% 3. CHUNG TU BAN HANG - NHAP HANG\nclass HoaDon {\n  -String maHoaDon\n  -LocalDate ngayLap\n  -KhachHang khachHang\n  -NhanVien nhanVien\n  -List~ChiTietHoaDon~ danhSachChiTiet\n  -TrangThaiHoaDon trangThai\n  -int soThuTuTiepTheo$\n  +HoaDon(String ma, LocalDate ngay, KhachHang kh, NhanVien nv)\n  +getMaHoaDon() String\n  +getNgayLap() LocalDate\n  +getTrangThai() TrangThaiHoaDon\n  +getDanhSachChiTiet() List~ChiTietHoaDon~\n  +themChiTiet(ChiTietHoaDon ct) boolean\n  +xoaChiTiet(String maSP) boolean\n  +tinhTongTien() BigDecimal\n  +coTheChinhSua() boolean\n  ~danhDauDaXacNhan() void\n  +taoMaTuDong() String$\n}\nclass ChiTietHoaDon {\n  -SanPham sanPham\n  -int soLuong\n  -BigDecimal donGiaBan\n  +ChiTietHoaDon(SanPham sp, int soLuong, BigDecimal donGia)\n  +getSanPham() SanPham\n  +getSoLuong() int\n  +getDonGiaBan() BigDecimal\n  +thanhTien() BigDecimal\n}\nclass PhieuNhap {\n  -String maPhieuNhap\n  -LocalDate ngayNhap\n  -NhaCungCap nhaCungCap\n  -NhanVien nhanVien\n  -List~ChiTietPhieuNhap~ danhSachChiTiet\n  -TrangThaiPhieuNhap trangThai\n  -int soThuTuTiepTheo$\n  +PhieuNhap(String ma, LocalDate ngay, NhaCungCap ncc, NhanVien nv)\n  +getMaPhieuNhap() String\n  +getNgayNhap() LocalDate\n  +getTrangThai() TrangThaiPhieuNhap\n  +getDanhSachChiTiet() List~ChiTietPhieuNhap~\n  +themChiTiet(ChiTietPhieuNhap ct) boolean\n  +xoaChiTiet(String maSP) boolean\n  +tinhTongTienNhap() BigDecimal\n  +coTheChinhSua() boolean\n  ~danhDauDaNhapKho() void\n  +taoMaTuDong() String$\n}\nclass ChiTietPhieuNhap {\n  -SanPham sanPham\n  -int soLuong\n  -BigDecimal donGiaNhap\n  +ChiTietPhieuNhap(SanPham sp, int soLuong, BigDecimal donGia)\n  +getSanPham() SanPham\n  +getSoLuong() int\n  +getDonGiaNhap() BigDecimal\n  +thanhTienNhap() BigDecimal\n}\nclass TrangThaiHoaDon {\n  &lt;&lt;enumeration&gt;&gt;\n  CHO_XAC_NHAN\n  DA_XAC_NHAN\n}\nclass TrangThaiPhieuNhap {\n  &lt;&lt;enumeration&gt;&gt;\n  CHO_XAC_NHAN\n  DA_NHAP_KHO\n}\n\n%% 4. QUAN LY DANH SACH\nclass IQuanLyDanhSach {\n  &lt;&lt;interface&gt;&gt;\n  +them(T item) boolean\n  +suaTheoMa(String ma, T item) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) T\n  +timGanDung(String tuKhoa) List~T~\n}\nclass DanhSachSanPham {\n  -SanPham[] ds\n  -int soLuong\n  +DanhSachSanPham(int sucChuaBanDau)\n  +nhapBanDau(SanPham[] dsBanDau) void\n  +xuatDanhSach() String\n  +them(SanPham sp) boolean\n  +themNhieu(SanPham[] dsMoi) int\n  +suaTheoMa(String ma, SanPham spMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) SanPham\n  +timGanDung(String tuKhoa) List~SanPham~\n  +locTheoDanhMuc(String maDM) List~SanPham~\n  +locTheoKhoangGia(BigDecimal min, BigDecimal max) List~SanPham~\n  +thongKeTheoDanhMuc() Map~String,Integer~\n  +lietKeSapHetHang(int nguong) List~SanPham~\n  +getSoLuong() int\n  -moRongMang() void\n}\nclass DanhSachKhachHang {\n  -List~KhachHang~ ds\n  +DanhSachKhachHang()\n  +them(KhachHang kh) boolean\n  +suaTheoMa(String ma, KhachHang khMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) KhachHang\n  +timGanDung(String tuKhoa) List~KhachHang~\n  +timTheoSoDienThoai(String sdt) List~KhachHang~\n  +getTatCa() List~KhachHang~\n}\nclass DanhSachNhaCungCap {\n  -List~NhaCungCap~ ds\n  +DanhSachNhaCungCap()\n  +them(NhaCungCap ncc) boolean\n  +suaTheoMa(String ma, NhaCungCap nccMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) NhaCungCap\n  +timGanDung(String tuKhoa) List~NhaCungCap~\n  +getTatCa() List~NhaCungCap~\n}\nclass DanhSachHoaDon {\n  -List~HoaDon~ ds\n  +DanhSachHoaDon()\n  +them(HoaDon hoaDon) boolean\n  +timTheoMa(String ma) HoaDon\n  +timTheoKhachHang(String maKH) List~HoaDon~\n  +locTheoNgay(LocalDate tuNgay, LocalDate denNgay) List~HoaDon~\n  +locTheoTrangThai(TrangThaiHoaDon tt) List~HoaDon~\n  +tongDoanhThu(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +getTatCa() List~HoaDon~\n}\nclass DanhSachPhieuNhap {\n  -List~PhieuNhap~ ds\n  +DanhSachPhieuNhap()\n  +them(PhieuNhap phieuNhap) boolean\n  +timTheoMa(String ma) PhieuNhap\n  +timTheoNhaCungCap(String maNCC) List~PhieuNhap~\n  +locTheoNgay(LocalDate tuNgay, LocalDate denNgay) List~PhieuNhap~\n  +locTheoTrangThai(TrangThaiPhieuNhap tt) List~PhieuNhap~\n  +tongGiaTriNhap(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +getTatCa() List~PhieuNhap~\n}\n\n%% 5. DICH VU - LUU TRU - BAO CAO\nclass DichVuKho {\n  -DanhSachSanPham danhSachSanPham\n  +DichVuKho(DanhSachSanPham ds)\n  +kiemTraTonKho(HoaDon hd) boolean\n  +xacNhanBanHang(HoaDon hd) void\n  +xacNhanNhapHang(PhieuNhap pn) void\n}\nclass LuuTruFileText {\n  -String thuMucDuLieu\n  -char KY_TU_PHAN_CACH$\n  +LuuTruFileText(String thuMuc)\n  +ghiDanhMuc(String path, List~DanhMuc~ ds) void\n  +docDanhMuc(String path) List~DanhMuc~\n  +ghiSanPham(String path, DanhSachSanPham ds) void\n  +docSanPham(String path, List~DanhMuc~ dsDM) DanhSachSanPham\n  +ghiKhachHang(String path, DanhSachKhachHang ds) void\n  +docKhachHang(String path) DanhSachKhachHang\n  +ghiNhaCungCap(String path, DanhSachNhaCungCap ds) void\n  +docNhaCungCap(String path) DanhSachNhaCungCap\n  +ghiNhanVien(String path, List~NhanVien~ ds) void\n  +docNhanVien(String path) List~NhanVien~\n  +ghiHoaDon(String path, DanhSachHoaDon ds) void\n  +docHoaDon(String path, DanhSachSanPham dsSP, DanhSachKhachHang dsKH, List~NhanVien~ dsNV) DanhSachHoaDon\n  +ghiPhieuNhap(String path, DanhSachPhieuNhap ds) void\n  +docPhieuNhap(String path, DanhSachSanPham dsSP, DanhSachNhaCungCap dsNCC, List~NhanVien~ dsNV) DanhSachPhieuNhap\n}\nclass BaoCaoThongKe {\n  -DanhSachSanPham danhSachSanPham\n  -DanhSachHoaDon danhSachHoaDon\n  -DanhSachPhieuNhap danhSachPhieuNhap\n  +BaoCaoThongKe(DanhSachSanPham sp, DanhSachHoaDon hd, DanhSachPhieuNhap pn)\n  +doanhThuTheoKhoang(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +giaTriNhapTheoKhoang(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +sanPhamBanChay(int topN) List~SanPham~\n  +canhBaoTonKho(int nguong) List~SanPham~\n  +giaTriTonKhoTheoGiaBan() BigDecimal\n}\n\n%% 6. QUAN HE UML\nGiayTheThao --|&gt; SanPham : ke thua\nQuanAoTheThao --|&gt; SanPham : ke thua\nDungCuTheThao --|&gt; SanPham : ke thua\nSanPham \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DanhMuc : thuoc danh muc\n\nHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; KhachHang : cua khach\nHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhanVien : do nhan vien lap\nHoaDon \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietHoaDon : gom chi tiet\nChiTietHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : san pham duoc ban\nHoaDon --&gt; TrangThaiHoaDon : trang thai\n\nPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhaCungCap : nhap tu\nPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhanVien : do nhan vien lap\nPhieuNhap \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietPhieuNhap : gom chi tiet\nChiTietPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : san pham duoc nhap\nPhieuNhap --&gt; TrangThaiPhieuNhap : trang thai\n\nDanhSachSanPham ..|&gt; IQuanLyDanhSach : implements\nDanhSachKhachHang ..|&gt; IQuanLyDanhSach : implements\nDanhSachNhaCungCap ..|&gt; IQuanLyDanhSach : implements\nDanhSachSanPham \&quot;1\&quot; o-- \&quot;0..*\&quot; SanPham : quan ly\nDanhSachKhachHang \&quot;1\&quot; o-- \&quot;0..*\&quot; KhachHang : quan ly\nDanhSachNhaCungCap \&quot;1\&quot; o-- \&quot;0..*\&quot; NhaCungCap : quan ly\nDanhSachHoaDon \&quot;1\&quot; o-- \&quot;0..*\&quot; HoaDon : quan ly\nDanhSachPhieuNhap \&quot;1\&quot; o-- \&quot;0..*\&quot; PhieuNhap : quan ly\n\nDichVuKho --&gt; DanhSachSanPham : cap nhat ton\nDichVuKho ..&gt; HoaDon : xac nhan ban hang\nDichVuKho ..&gt; PhieuNhap : xac nhan nhap hang\n\nBaoCaoThongKe --&gt; DanhSachSanPham : thong ke ton\nBaoCaoThongKe --&gt; DanhSachHoaDon : doanh thu\nBaoCaoThongKe --&gt; DanhSachPhieuNhap : gia tri nhap\n\nLuuTruFileText ..&gt; DanhSachSanPham : doc ghi\nLuuTruFileText ..&gt; DanhSachKhachHang : doc ghi\nLuuTruFileText ..&gt; DanhSachNhaCungCap : doc ghi\nLuuTruFileText ..&gt; DanhSachHoaDon : doc ghi\nLuuTruFileText ..&gt; DanhSachPhieuNhap : doc ghi\nLuuTruFileText ..&gt; DanhMuc : doc ghi\nLuuTruFileText ..&gt; NhanVien : doc ghi&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="k6phIiresY1YxXdD_GA--2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
