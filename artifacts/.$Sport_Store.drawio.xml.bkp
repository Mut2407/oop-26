  <diagram name="03 - Bán hàng &amp; nhập kho" id="sWq4nRfIrDA8aPEb5K63">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\n%% =========================================\n%% 03 - BAN HANG VA NHAP KHO\n%% DONG BO THEO TRANG 01\n%% =========================================\n\n%% 1. SAN PHAM - DU LIEU KHO\nclass SanPham {\n  &lt;&lt;abstract&gt;&gt;\n  -String maSanPham\n  -String tenSanPham\n  -String thuongHieu\n  -BigDecimal giaBan\n  -int soLuongTon\n  -String mauSac\n  -String chatLieu\n  -DanhMuc danhMuc\n  +SanPham(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm)\n  +getMaSanPham() String\n  +getTenSanPham() String\n  +getGiaBan() BigDecimal\n  +getSoLuongTon() int\n  +getDanhMuc() DanhMuc\n  +capNhatThongTin(String ten, String hang, String mau, String chatLieu) void\n  +capNhatGiaBan(BigDecimal giaMoi) void\n  +conDuHang(int soLuong) boolean\n  +tangTon(int soLuong) void\n  +giamTon(int soLuong) void\n  +tinhGiaTriTonTheoGiaBan() BigDecimal\n  +layLoaiSanPham() String*\n  +hienThiThongTin() String*\n}\n\n%% 2. DOI TUONG GIAO DICH\nclass KhachHang {\n  -String maKhachHang\n  -String hoTen\n  -String soDienThoai\n  -String diaChi\n  +KhachHang(String ma, String ten, String sdt, String diaChi)\n  +getMaKhachHang() String\n  +getHoTen() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\n\nclass NhanVien {\n  -String maNhanVien\n  -String hoTen\n  -String soDienThoai\n  -String caLamViec\n  +NhanVien(String ma, String ten, String sdt, String ca)\n  +getMaNhanVien() String\n  +getHoTen() String\n  +capNhatLienHe(String soDienThoai) void\n  +doiCaLamViec(String caMoi) void\n  +hienThiThongTin() String\n}\n\nclass NhaCungCap {\n  -String maNhaCungCap\n  -String tenNhaCungCap\n  -String soDienThoai\n  -String diaChi\n  +NhaCungCap(String ma, String ten, String sdt, String diaChi)\n  +getMaNhaCungCap() String\n  +getTenNhaCungCap() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\n\n%% 3. HOA DON BAN HANG\nclass HoaDon {\n  -String maHoaDon\n  -LocalDate ngayLap\n  -KhachHang khachHang\n  -NhanVien nhanVien\n  -List~ChiTietHoaDon~ danhSachChiTiet\n  -TrangThaiHoaDon trangThai\n  -int soThuTuTiepTheo$\n  +HoaDon(String ma, LocalDate ngay, KhachHang kh, NhanVien nv)\n  +getMaHoaDon() String\n  +getNgayLap() LocalDate\n  +getTrangThai() TrangThaiHoaDon\n  +getDanhSachChiTiet() List~ChiTietHoaDon~\n  +themChiTiet(ChiTietHoaDon ct) boolean\n  +xoaChiTiet(String maSP) boolean\n  +tinhTongTien() BigDecimal\n  +coTheChinhSua() boolean\n  ~danhDauDaXacNhan() void\n  +taoMaTuDong() String$\n}\n\nclass ChiTietHoaDon {\n  -SanPham sanPham\n  -int soLuong\n  -BigDecimal donGiaBan\n  +ChiTietHoaDon(SanPham sp, int soLuong, BigDecimal donGia)\n  +getSanPham() SanPham\n  +getSoLuong() int\n  +getDonGiaBan() BigDecimal\n  +thanhTien() BigDecimal\n}\n\nclass TrangThaiHoaDon {\n  &lt;&lt;enumeration&gt;&gt;\n  CHO_XAC_NHAN\n  DA_XAC_NHAN\n}\n\n%% 4. PHIEU NHAP HANG\nclass PhieuNhap {\n  -String maPhieuNhap\n  -LocalDate ngayNhap\n  -NhaCungCap nhaCungCap\n  -NhanVien nhanVien\n  -List~ChiTietPhieuNhap~ danhSachChiTiet\n  -TrangThaiPhieuNhap trangThai\n  -int soThuTuTiepTheo$\n  +PhieuNhap(String ma, LocalDate ngay, NhaCungCap ncc, NhanVien nv)\n  +getMaPhieuNhap() String\n  +getNgayNhap() LocalDate\n  +getTrangThai() TrangThaiPhieuNhap\n  +getDanhSachChiTiet() List~ChiTietPhieuNhap~\n  +themChiTiet(ChiTietPhieuNhap ct) boolean\n  +xoaChiTiet(String maSP) boolean\n  +tinhTongTienNhap() BigDecimal\n  +coTheChinhSua() boolean\n  ~danhDauDaNhapKho() void\n  +taoMaTuDong() String$\n}\n\nclass ChiTietPhieuNhap {\n  -SanPham sanPham\n  -int soLuong\n  -BigDecimal donGiaNhap\n  +ChiTietPhieuNhap(SanPham sp, int soLuong, BigDecimal donGia)\n  +getSanPham() SanPham\n  +getSoLuong() int\n  +getDonGiaNhap() BigDecimal\n  +thanhTienNhap() BigDecimal\n}\n\nclass TrangThaiPhieuNhap {\n  &lt;&lt;enumeration&gt;&gt;\n  CHO_XAC_NHAN\n  DA_NHAP_KHO\n}\n\n%% 5. DANH SACH SAN PHAM\nclass DanhSachSanPham {\n  -SanPham[] ds\n  -int soLuong\n  +DanhSachSanPham(int sucChuaBanDau)\n  +nhapBanDau(SanPham[] dsBanDau) void\n  +xuatDanhSach() String\n  +them(SanPham sp) boolean\n  +themNhieu(SanPham[] dsMoi) int\n  +suaTheoMa(String ma, SanPham spMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) SanPham\n  +timGanDung(String tuKhoa) List~SanPham~\n  +locTheoDanhMuc(String maDM) List~SanPham~\n  +locTheoKhoangGia(BigDecimal min, BigDecimal max) List~SanPham~\n  +thongKeTheoDanhMuc() Map~String,Integer~\n  +lietKeSapHetHang(int nguong) List~SanPham~\n  +getSoLuong() int\n  -moRongMang() void\n}\n\n%% 6. DANH SACH HOA DON\nclass DanhSachHoaDon {\n  -List~HoaDon~ ds\n  +DanhSachHoaDon()\n  +them(HoaDon hoaDon) boolean\n  +timTheoMa(String ma) HoaDon\n  +timTheoKhachHang(String maKH) List~HoaDon~\n  +locTheoNgay(LocalDate tuNgay, LocalDate denNgay) List~HoaDon~\n  +locTheoTrangThai(TrangThaiHoaDon tt) List~HoaDon~\n  +tongDoanhThu(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +getTatCa() List~HoaDon~\n}\n\n%% 7. DANH SACH PHIEU NHAP\nclass DanhSachPhieuNhap {\n  -List~PhieuNhap~ ds\n  +DanhSachPhieuNhap()\n  +them(PhieuNhap phieuNhap) boolean\n  +timTheoMa(String ma) PhieuNhap\n  +timTheoNhaCungCap(String maNCC) List~PhieuNhap~\n  +locTheoNgay(LocalDate tuNgay, LocalDate denNgay) List~PhieuNhap~\n  +locTheoTrangThai(TrangThaiPhieuNhap tt) List~PhieuNhap~\n  +tongGiaTriNhap(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +getTatCa() List~PhieuNhap~\n}\n\n%% 8. DICH VU KHO\nclass DichVuKho {\n  -DanhSachSanPham danhSachSanPham\n  +DichVuKho(DanhSachSanPham ds)\n  +kiemTraTonKho(HoaDon hd) boolean\n  +xacNhanBanHang(HoaDon hd) void\n  +xacNhanNhapHang(PhieuNhap pn) void\n}\n\n%% 9. BAO CAO THONG KE\nclass BaoCaoThongKe {\n  -DanhSachSanPham danhSachSanPham\n  -DanhSachHoaDon danhSachHoaDon\n  -DanhSachPhieuNhap danhSachPhieuNhap\n  +BaoCaoThongKe(DanhSachSanPham sp, DanhSachHoaDon hd, DanhSachPhieuNhap pn)\n  +doanhThuTheoKhoang(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +giaTriNhapTheoKhoang(LocalDate tuNgay, LocalDate denNgay) BigDecimal\n  +sanPhamBanChay(int topN) List~SanPham~\n  +canhBaoTonKho(int nguong) List~SanPham~\n  +giaTriTonKhoTheoGiaBan() BigDecimal\n}\n\n%% =========================================\n%% 10. CAC QUAN HE UML\n%% =========================================\n\n%% QUAN HE HOA DON VA KHACH HANG / NHAN VIEN\nHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; KhachHang : cua khach\nHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhanVien : do nhan vien lap\n\n%% COMPOSITION - HOA DON CHUA CHI TIET\nHoaDon \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietHoaDon : gom chi tiet\nChiTietHoaDon \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : san pham duoc ban\n\n%% TRANG THAI HOA DON\nHoaDon --&gt; TrangThaiHoaDon : trang thai\n\n%% QUAN HE PHIEU NHAP\nPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhaCungCap : nhap tu\nPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; NhanVien : do nhan vien lap\n\n%% COMPOSITION - PHIEU NHAP CHUA CHI TIET\nPhieuNhap \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietPhieuNhap : gom chi tiet\nChiTietPhieuNhap \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham : san pham duoc nhap\n\n%% TRANG THAI PHIEU NHAP\nPhieuNhap --&gt; TrangThaiPhieuNhap : trang thai\n\n%% AGGREGATION - QUAN LY DANH SACH\nDanhSachSanPham \&quot;1\&quot; o-- \&quot;0..*\&quot; SanPham : quan ly\nDanhSachHoaDon \&quot;1\&quot; o-- \&quot;0..*\&quot; HoaDon : quan ly\nDanhSachPhieuNhap \&quot;1\&quot; o-- \&quot;0..*\&quot; PhieuNhap : quan ly\n\n%% KHO - CAP NHAT TON KHO KHI GIAO DICH\nDichVuKho --&gt; DanhSachSanPham : cap nhat ton\nDichVuKho ..&gt; HoaDon : xac nhan ban hang\nDichVuKho ..&gt; PhieuNhap : xac nhan nhap hang\n\n%% BAO CAO - SU DUNG CAC DANH SACH\nBaoCaoThongKe --&gt; DanhSachSanPham : thong ke ton\nBaoCaoThongKe --&gt; DanhSachHoaDon : doanh thu\nBaoCaoThongKe --&gt; DanhSachPhieuNhap : gia tri nhap\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Hiv8N2vU11fMIV_cR5i--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SanPham&lt;/b&gt;" mermaidId="n:SanPham" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;SanPham&lt;/b&gt;" id="Hiv8N2vU11fMIV_cR5i--2">
