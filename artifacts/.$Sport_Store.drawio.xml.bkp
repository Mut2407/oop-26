  <diagram name="02 - Sản phẩm &amp; danh sách" id="uHpZ_LgR3cnghIzIMzMy">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\n%% =========================================\n%% 02 - SAN PHAM VA DANH SACH\n%% DONG BO THEO TRANG 01\n%% =========================================\n\n%% 1. SAN PHAM\nclass SanPham {\n  &lt;&lt;abstract&gt;&gt;\n  -String maSanPham\n  -String tenSanPham\n  -String thuongHieu\n  -BigDecimal giaBan\n  -int soLuongTon\n  -String mauSac\n  -String chatLieu\n  -DanhMuc danhMuc\n  +SanPham(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm)\n  +getMaSanPham() String\n  +getTenSanPham() String\n  +getGiaBan() BigDecimal\n  +getSoLuongTon() int\n  +getDanhMuc() DanhMuc\n  +capNhatThongTin(String ten, String hang, String mau, String chatLieu) void\n  +capNhatGiaBan(BigDecimal giaMoi) void\n  +conDuHang(int soLuong) boolean\n  +tangTon(int soLuong) void\n  +giamTon(int soLuong) void\n  +tinhGiaTriTonTheoGiaBan() BigDecimal\n  +layLoaiSanPham() String*\n  +hienThiThongTin() String*\n}\n\nclass GiayTheThao {\n  -String kichCoGiay\n  -String loaiDeGiay\n  +GiayTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, String kichCo, String loaiDe)\n  +getKichCoGiay() String\n  +getLoaiDeGiay() String\n  +capNhatKichCo(String kichCoMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\n\nclass QuanAoTheThao {\n  -String kichCoQuanAo\n  +QuanAoTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, String kichCo)\n  +getKichCoQuanAo() String\n  +capNhatKichCo(String kichCoMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\n\nclass DungCuTheThao {\n  -double khoiLuongKg\n  +DungCuTheThao(String ma, String ten, String hang, BigDecimal gia, int ton, String mau, String chatLieu, DanhMuc dm, double khoiLuongKg)\n  +getKhoiLuongKg() double\n  +capNhatKhoiLuong(double khoiLuongMoi) void\n  +layLoaiSanPham() String\n  +hienThiThongTin() String\n}\n\nclass DanhMuc {\n  -String maDanhMuc\n  -String tenDanhMuc\n  -String moTa\n  +DanhMuc(String ma, String ten, String moTa)\n  +getMaDanhMuc() String\n  +getTenDanhMuc() String\n  +capNhatThongTin(String ten, String moTa) void\n  +hienThiThongTin() String\n}\n\n%% 2. INTERFACE QUAN LY\nclass IQuanLyDanhSach {\n  &lt;&lt;interface&gt;&gt;\n  +them(T item) boolean\n  +suaTheoMa(String ma, T item) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) T\n  +timGanDung(String tuKhoa) List~T~\n}\n\n%% 3. DANH SACH SAN PHAM\nclass DanhSachSanPham {\n  -SanPham[] ds\n  -int soLuong\n  +DanhSachSanPham(int sucChuaBanDau)\n  +nhapBanDau(SanPham[] dsBanDau) void\n  +xuatDanhSach() String\n  +them(SanPham sp) boolean\n  +themNhieu(SanPham[] dsMoi) int\n  +suaTheoMa(String ma, SanPham spMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) SanPham\n  +timGanDung(String tuKhoa) List~SanPham~\n  +locTheoDanhMuc(String maDM) List~SanPham~\n  +locTheoKhoangGia(BigDecimal min, BigDecimal max) List~SanPham~\n  +thongKeTheoDanhMuc() Map~String,Integer~\n  +lietKeSapHetHang(int nguong) List~SanPham~\n  +getSoLuong() int\n  -moRongMang() void\n}\n\n%% 4. KHACH HANG\nclass KhachHang {\n  -String maKhachHang\n  -String hoTen\n  -String soDienThoai\n  -String diaChi\n  +KhachHang(String ma, String ten, String sdt, String diaChi)\n  +getMaKhachHang() String\n  +getHoTen() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\n\nclass DanhSachKhachHang {\n  -List~KhachHang~ ds\n  +DanhSachKhachHang()\n  +them(KhachHang kh) boolean\n  +suaTheoMa(String ma, KhachHang khMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) KhachHang\n  +timGanDung(String tuKhoa) List~KhachHang~\n  +timTheoSoDienThoai(String sdt) List~KhachHang~\n  +getTatCa() List~KhachHang~\n}\n\n%% 5. NHA CUNG CAP\nclass NhaCungCap {\n  -String maNhaCungCap\n  -String tenNhaCungCap\n  -String soDienThoai\n  -String diaChi\n  +NhaCungCap(String ma, String ten, String sdt, String diaChi)\n  +getMaNhaCungCap() String\n  +getTenNhaCungCap() String\n  +capNhatThongTin(String ten, String sdt, String diaChi) void\n  +hienThiThongTin() String\n}\n\nclass DanhSachNhaCungCap {\n  -List~NhaCungCap~ ds\n  +DanhSachNhaCungCap()\n  +them(NhaCungCap ncc) boolean\n  +suaTheoMa(String ma, NhaCungCap nccMoi) boolean\n  +xoaTheoMa(String ma) boolean\n  +timTheoMa(String ma) NhaCungCap\n  +timGanDung(String tuKhoa) List~NhaCungCap~\n  +getTatCa() List~NhaCungCap~\n}\n\n%% 6. DOC / GHI FILE TEXT\nclass LuuTruFileText {\n  -String thuMucDuLieu\n  -char KY_TU_PHAN_CACH$\n  +LuuTruFileText(String thuMuc)\n  +ghiDanhMuc(String path, List~DanhMuc~ ds) void\n  +docDanhMuc(String path) List~DanhMuc~\n  +ghiSanPham(String path, DanhSachSanPham ds) void\n  +docSanPham(String path, List~DanhMuc~ dsDM) DanhSachSanPham\n  +ghiKhachHang(String path, DanhSachKhachHang ds) void\n  +docKhachHang(String path) DanhSachKhachHang\n  +ghiNhaCungCap(String path, DanhSachNhaCungCap ds) void\n  +docNhaCungCap(String path) DanhSachNhaCungCap\n  +ghiNhanVien(String path, List~NhanVien~ ds) void\n  +docNhanVien(String path) List~NhanVien~\n  +ghiHoaDon(String path, DanhSachHoaDon ds) void\n  +docHoaDon(String path, DanhSachSanPham dsSP, DanhSachKhachHang dsKH, List~NhanVien~ dsNV) DanhSachHoaDon\n  +ghiPhieuNhap(String path, DanhSachPhieuNhap ds) void\n  +docPhieuNhap(String path, DanhSachSanPham dsSP, DanhSachNhaCungCap dsNCC, List~NhanVien~ dsNV) DanhSachPhieuNhap\n}\n\n%% =========================================\n%% 7. CAC QUAN HE UML\n%% =========================================\n\n%% KE THUA\nGiayTheThao --|&gt; SanPham : ke thua\nQuanAoTheThao --|&gt; SanPham : ke thua\nDungCuTheThao --|&gt; SanPham : ke thua\n\n%% LIEN KET DANH MUC\nSanPham \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DanhMuc : thuoc danh muc\n\n%% IMPLEMENTS INTERFACE\nDanhSachSanPham ..|&gt; IQuanLyDanhSach : implements\nDanhSachKhachHang ..|&gt; IQuanLyDanhSach : implements\nDanhSachNhaCungCap ..|&gt; IQuanLyDanhSach : implements\n\n%% AGGREGATION\nDanhSachSanPham \&quot;1\&quot; o-- \&quot;0..*\&quot; SanPham : quan ly\nDanhSachKhachHang \&quot;1\&quot; o-- \&quot;0..*\&quot; KhachHang : quan ly\nDanhSachNhaCungCap \&quot;1\&quot; o-- \&quot;0..*\&quot; NhaCungCap : quan ly\n\n%% DEPENDENCY - DOC / GHI DU LIEU\nLuuTruFileText ..&gt; DanhMuc : doc ghi\nLuuTruFileText ..&gt; DanhSachSanPham : doc ghi\nLuuTruFileText ..&gt; DanhSachKhachHang : doc ghi\nLuuTruFileText ..&gt; DanhSachNhaCungCap : doc ghi\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="qUABf63D5HwcZFJ-pC5h-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SanPham&lt;/b&gt;" mermaidId="n:SanPham" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=66;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;spacingTop=24;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;SanPham&lt;/b&gt;" id="qUABf63D5HwcZFJ-pC5h-2">
