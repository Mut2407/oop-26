<mxfile host="app.diagrams.net" pages="3">
  <diagram name="01 - Tổng quan (20 class)" id="AqDUw7xHZeKoWfD3By1L">
    <mxGraphModel dx="7442" dy="3911" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4000" pageHeight="3000" math="0" shadow="0">
